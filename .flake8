[flake8]
# The algorithm code predates flake8 and still carries a lot of formatting drift.
# The pre-push gate keeps the checks that catch real problems (syntax errors,
# undefined names, broken comparisons); run `flake8 --select=E,W,F` to see the
# complete report, style included.
max-line-length = 120
select = E9,F63,F7,F82

extend-exclude =
    build,
    dist,
    .pytest_cache,
    .ruff_cache,
    .venv,
    venv,
    env
